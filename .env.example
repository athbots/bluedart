# YatriQ — Environment Configuration

PROJECT_NAME="YatriQ"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Security
SECRET_KEY="transit-secret-key-change-in-production-2026-secure"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Local development (SQLite default):
DATABASE_URL="sqlite:///./transit.db"
# Production (PostgreSQL):
# DATABASE_URL="postgresql://transit_user:transit_secure_password_2026@localhost:5432/smart_transit"

# Cache / Live State
# REDIS_URL="redis://localhost:6379/0"
USE_IN_MEMORY_CACHE=True

# MQTT Broker
MQTT_BROKER_HOST="localhost"
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX="transit"

# Telemetry Stale Thresholds (Seconds)
STALE_LOCATION_SECONDS=30
STALE_CROWD_SECONDS=60

# ML Models
ML_MODELS_DIR="./ml/models"
